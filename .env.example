# URL pública de la aplicacion del sistema
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==========================================
# SUPABASE (Backend & Frontend)
# ==========================================
# URL de tu instancia de Supabase (Local o Cloud)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Clave pública (Anon Key). SEGURA para el frontend.
# Se genera con: supabase status o en el dashboard de Supabase
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<TU_ANON_KEY_AQUI>

# Clave secreta (Service Role). PELIGROSO exponer esto en el frontend.
# Úsala SOLO en server components, API routes o edge functions.
SUPABASE_SECRET_KEY=<TU_SERVICE_ROLE_KEY_AQUI>

# Opcional: Si usas autenticación manual o migraciones antiguas
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<TU_ANON_KEY_LEGACY>
# SUPABASE_SERVICE_ROLE_KEY=<TU_SERVICE_ROLE_KEY_LEGACY>

# ==========================================
# STORAGE (Supabase Storage)
# ==========================================
# Nombre del bucket para certificados
SUPABASE_CERTIFICADOS_BUCKET=certificados

# ==========================================
# AUTENTICACIÓN (Lógica de negocio)
# ==========================================
# Configuración para "Login con Código" (OTP)
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_LENGTH=7
# Código fijo para pruebas locales (ej: "ABC1234")
AUTH_DEV_FIXED_CODE=<CODIGO_FIJO_DE_PRUEBA>
PASSWORD_RESET_SESSION_TTL_MINUTES=10

# ==========================================
# SMTP (Enviar correos electrónicos)
# ==========================================
# Opción 1: SMTP directo (Recomendado para desarrollo local con Gmail)
# - Necesitas una "Contraseña de Aplicación" si tienes 2FA activado en Google
EMAIL_FROM="TuApp <tu-correo@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<TU_CORREO_GMAIL>
SMTP_PASSWORD=<TU_CONTRASENA_DE_APLICACION>

# Opción 2: OAuth2 de Google (Para producción o mayor seguridad)
# Si rellenas estas variables, el sistema usará OAuth2 en lugar de SMTP_PASSWORD
# GOOGLE_CLIENT_ID=<TU_CLIENT_ID_DE_CONSOLA_GOOGLE>
# GOOGLE_CLIENT_SECRET=<TU_CLIENT_SECRET_DE_CONSOLA_GOOGLE>
# GOOGLE_REFRESH_TOKEN=<TU_REFRESH_TOKEN_OBTENIDO>

# ==========================================
# VARIABLES OPCIONALES (Según config.toml)
# ==========================================
# Si activas Twilio en config.toml ([auth.sms.twilio])
# SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=<TU_TWILIO_TOKEN>
# Si usas S3 externo en config.toml ([experimental])
# S3_HOST=<TU_URL_S3>
# S3_REGION=<TU_REGION>
# S3_ACCESS_KEY=<TU_ACCESS_KEY>
# S3_SECRET_KEY=<TU_SECRET_KEY>
