NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxx

# Backend only. Nunca la expongas en componentes cliente.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxx

# Compatibilidad con llaves legacy de Supabase, si tu proyecto todavia las usa:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Storage
SUPABASE_CERTIFICADOS_BUCKET=certificados

# Login con codigo. En desarrollo puedes fijarlo para pruebas.
AUTH_CODE_TTL_MINUTES=10
AUTH_CODE_LENGTH=7
AUTH_DEV_FIXED_CODE=A1B2C3D
PASSWORD_RESET_SESSION_TTL_MINUTES=10

# Correos con Google/Gmail via SMTP.
# Opcion simple recomendada para desarrollo: activa 2FA en Google y crea una
# contrasena de aplicacion para SMTP_PASSWORD.
EMAIL_FROM="MyCertify <tu-correo@gmail.com>"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu-correo@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Opcion OAuth2 de Google si prefieres no usar contrasena de aplicacion.
# Si GOOGLE_REFRESH_TOKEN existe, el backend usara OAuth2 en lugar de SMTP_PASSWORD.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REFRESH_TOKEN=
